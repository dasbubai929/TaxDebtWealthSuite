---
import Layout from "../../layouts/Layout.astro";
import CapitalGainsTaxCalculator from "../../components/CapitalGainsTaxCalculator.astro";
---

<Layout
  title="Capital Gains Tax Calculator (US) | Estimate Your Tax Liability"
  description="Free capital gains tax calculator for the US. Estimate short-term and long-term tax rates, including the Net Investment Income Tax (NIIT)."
  ogImage="https://taxdebtwealthsuite.com/images/og-capital-gains-tax.png"
>
  <link rel="alternate" hreflang="x-default" href="https://taxdebtwealthsuite.com/capital-gains-tax-calculator/" slot="head" />
  <link rel="alternate" hreflang="en-us" href="https://taxdebtwealthsuite.com/capital-gains-tax-calculator/" slot="head" />
  <link rel="alternate" hreflang="en-gb" href="https://taxdebtwealthsuite.com/capital-gains-tax-calculator/uk/" slot="head" />
  <link rel="alternate" hreflang="en-ca" href="https://taxdebtwealthsuite.com/capital-gains-tax-calculator/canada/" slot="head" />
  <link rel="alternate" hreflang="en-au" href="https://taxdebtwealthsuite.com/capital-gains-tax-calculator/australia/" slot="head" />

  <script type="application/ld+json" is:inline slot="head">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "FinanceApplication",
        "name": "Capital Gains Tax Calculator (US)",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "provider": { "@id": "https://taxdebtwealthsuite.com/#organization" },
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "description": "Estimate short-term and long-term capital gains tax liability under IRS rules, including the 3.8% NIIT."
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How is long-term capital gains tax calculated in the US?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Long-term capital gains apply to assets held longer than one year. The profit is taxed at 0%, 15%, or 20% based on your filing status and taxable income for the year."
            }
          },
          {
            "@type": "Question",
            "name": "What is the Net Investment Income Tax (NIIT)?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The NIIT is a 3.8% surcharge on investment income for individuals whose modified adjusted gross income exceeds certain thresholds ($200,000 for Single, $250,000 for Married Filing Jointly)."
            }
          },
          {
            "@type": "Question",
            "name": "How does the Section 121 Primary Residence Exclusion work for US real estate?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "If you sell your main home, you can exclude up to $250,000 of capital gain ($500,000 for married couples filing jointly) from federal income tax if you owned and lived in the home as your primary residence for at least 2 out of the 5 years prior to sale."
            }
          },
          {
            "@type": "Question",
            "name": "How do capital loss carryforwards work in the United States?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "If your capital losses exceed your capital gains in a tax year, you can use the net loss to offset up to $3,000 of ordinary income ($1,500 if married filing separately). Any remaining net loss can be carried forward indefinitely to future tax years."
            }
          }
        ]
      }
    ]
  }
  </script>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold text-white tracking-tight font-sans">
        Capital Gains Tax Calculator
      </h1>
      <p class="mt-2 text-sm text-slate-400 max-w-3xl">
        Model your potential tax liability on the sale of assets like stocks, real estate, or crypto under IRS rules including short-term, long-term rates, and the 3.8% NIIT.
      </p>
    </div>

    <CapitalGainsTaxCalculator defaultCountry="US" />

    <!-- Explanatory Content Wrapper -->
    <div class="mt-12 space-y-8 text-slate-300">
      <!-- Introduction Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00F5D4]/10 text-[#00F5D4] text-xs font-bold uppercase tracking-wider border border-[#00F5D4]/20">
          <span>US Tax Framework</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Introduction</h2>
        <p class="text-slate-300 leading-relaxed">
          Capital gains tax in the United States is determined primarily by your asset holding period and overall taxable income level. Profits realized on investments held for one year or less are classified as short-term capital gains and taxed at ordinary federal income tax rates ranging from 10% to 37%. Assets held for longer than one year qualify for favorable long-term capital gains tax rates of 0%, 15%, or 20%. High-income taxpayers may also incur the 3.8% Net Investment Income Tax (NIIT) and state capital gains taxes. This calculator models your total federal tax obligation, evaluating short-term versus long-term holding brackets to help optimize sale timing.
        </p>
      </section>

      <!-- Key Benefits Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7B61FF]/10 text-[#7B61FF] text-xs font-bold uppercase tracking-wider border border-[#7B61FF]/20">
          <span>Strategic Value</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Key Benefits</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Calculate Short-Term vs. Long-Term Rates</strong>
              <span class="text-sm text-slate-400">Compare ordinary income tax rates on short-term sales against preferential 0%, 15%, and 20% long-term brackets.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Evaluate 3.8% Net Investment Income Tax (NIIT)</strong>
              <span class="text-sm text-slate-400">Determine if your Modified Adjusted Gross Income (MAGI) triggers the 3.8% NIIT threshold.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Account for Cost Basis & Adjustments</strong>
              <span class="text-sm text-slate-400">Factor in purchase price, reinvested dividends, and capital improvement additions to lower total taxable gain.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Plan Tax-Loss Offset Strategies</strong>
              <span class="text-sm text-slate-400">Calculate how realizing capital losses offsets up to $3,000 of ordinary income and reduces total capital gains tax.</span>
            </div>
          </li>
        </ul>
      </section>

      <!-- FAQ Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00F5D4]/10 text-[#00F5D4] text-xs font-bold uppercase tracking-wider border border-[#00F5D4]/20">
          <span>Common Questions</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>How is long-term capital gains tax calculated in the US?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              Long-term capital gains apply to assets held longer than one year. The profit is taxed at 0%, 15%, or 20% based on your filing status and taxable income for the year.
            </div>
          </div>

          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>What is the Net Investment Income Tax (NIIT)?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              The NIIT is a 3.8% surcharge on investment income for individuals whose modified adjusted gross income exceeds certain thresholds ($200,000 for Single, $250,000 for Married Filing Jointly).
            </div>
          </div>

          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>How does the Section 121 Primary Residence Exclusion work for US real estate?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              If you sell your main home, you can exclude up to $250,000 of capital gain ($500,000 for married couples filing jointly) from federal income tax if you owned and lived in the home as your primary residence for at least 2 out of the 5 years prior to sale.
            </div>
          </div>

          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>How do capital loss carryforwards work in the United States?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              If your capital losses exceed your capital gains in a tax year, you can use the net loss to offset up to $3,000 of ordinary income ($1,500 if married filing separately). Any remaining net loss can be carried forward indefinitely to future tax years.
            </div>
          </div>
        </div>
      </section>

      <!-- Methodology Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7B61FF]/10 text-[#7B61FF] text-xs font-bold uppercase tracking-wider border border-[#7B61FF]/20">
          <span>Calculation Logic</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Methodology</h2>
        <div class="space-y-4 text-sm sm:text-base text-slate-300 leading-relaxed">
          <p>
            This calculator determines taxable capital gain by subtracting your adjusted cost basis (original purchase price plus allowable improvements and transaction fees) from total sales proceeds. Assets held 365 days or less are classified as short-term gains and added to ordinary taxable income.
          </p>
          <p>
            For assets held longer than 365 days, the tool applies federal long-term progressive brackets (0%, 15%, 20%) based on your filing status and total taxable income. It evaluates Modified Adjusted Gross Income (MAGI) thresholds ($200k single / $250k married) to include the 3.8% Net Investment Income Tax (NIIT) under Internal Revenue Code Section 1411.
          </p>
          <div class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] text-xs text-slate-400 space-y-2">
            <p><strong>Official Reference:</strong> <a href="https://www.irs.gov/taxtopics/tc409" target="_blank" rel="noopener noreferrer" class="text-[#00F5D4] hover:underline font-medium">IRS Topic No. 409 (Capital Gains and Losses) →</a></p>
            <p class="italic text-slate-500">Calculations are estimates, consult a CPA or licensed tax professional for specific tax filing advice.</p>
          </div>
        </div>
      </section>

      <!-- Related Calculators Section -->
      <section class="space-y-4 pt-4">
        <h3 class="text-xl font-bold text-white tracking-tight">Related Calculators & Tools</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/tax-loss-harvesting-calculator/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#00F5D4]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#00F5D4] uppercase">Loss Offsetting</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#00F5D4] transition-colors">Tax-Loss Harvesting Calculator</h4>
            <p class="text-xs text-slate-400">Calculate how realizing capital losses directly offsets taxable capital gains and ordinary income.</p>
          </a>
          <a href="/buy-borrow-die-calculator/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#7B61FF]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#7B61FF] uppercase">Wealth Retention</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#7B61FF] transition-colors">Buy, Borrow, Die Calculator</h4>
            <p class="text-xs text-slate-400">Model borrowing against appreciated portfolios to avoid triggering realized capital gains taxes.</p>
          </a>
          <a href="/roth-conversion-calculator/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#00F5D4]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#00F5D4] uppercase">Tax-Free Conversion</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#00F5D4] transition-colors">Roth Conversion Calculator</h4>
            <p class="text-xs text-slate-400">Model pre-tax retirement account conversions to build tax-free investment growth.</p>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>
