---
import Layout from "../../../layouts/Layout.astro";
import BuyBorrowDieCalculator from "../../../components/BuyBorrowDieCalculator.astro";
---

<Layout
  title="Buy, Borrow, Die Calculator (Australia) | TaxDebtWealthSuite"
  description="Model the Buy, Borrow, Die strategy in Australia. Compare margin loan borrowing costs vs Capital Gains Tax, check margin call risk, and see your net wealth advantage."
  ogImage="https://taxdebtwealthsuite.com/images/og-buy-borrow-die.png"
>
  <link rel="alternate" hreflang="x-default" href="https://taxdebtwealthsuite.com/buy-borrow-die-calculator/" slot="head" />
  <link rel="alternate" hreflang="en-us" href="https://taxdebtwealthsuite.com/buy-borrow-die-calculator/" slot="head" />
  <link rel="alternate" hreflang="en-gb" href="https://taxdebtwealthsuite.com/buy-borrow-die-calculator/uk/" slot="head" />
  <link rel="alternate" hreflang="en-ca" href="https://taxdebtwealthsuite.com/buy-borrow-die-calculator/canada/" slot="head" />
  <link rel="alternate" hreflang="en-au" href="https://taxdebtwealthsuite.com/buy-borrow-die-calculator/australia/" slot="head" />

  <script type="application/ld+json" is:inline slot="head">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "FinanceApplication",
        "name": "Buy, Borrow, Die Calculator (Australia)",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "author": { "@id": "https://taxdebtwealthsuite.com/author/#person" },
        "provider": { "@id": "https://taxdebtwealthsuite.com/#organization" },
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "AUD" },
        "description": "Model the Buy, Borrow, Die strategy in Australia. Compare margin loan borrowing costs vs Capital Gains Tax, check margin call risk, and see your net wealth advantage."
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the Buy, Borrow, Die strategy legal?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, borrowing against your own assets is a standard financial practice and does not trigger a taxable event under current tax guidelines."
            }
          },
          {
            "@type": "Question",
            "name": "Is death a Capital Gains Tax (CGT) event in Australia?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Under Section 128-10 of the ITAA 1997, passing away does not trigger a CGT event. The asset transfers to your estate or beneficiary with the cost basis rolled over, deferring CGT until the beneficiary sells."
            }
          },
          {
            "@type": "Question",
            "name": "How does the 50% CGT discount affect the borrowing comparison in Australia?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Because Australian individuals receive a 50% CGT discount on assets held for over 12 months, the effective tax rate on liquidation is reduced by half. Your margin loan interest rate must be weighed against this reduced effective tax liability."
            }
          }
        ]
      }
    ]
  }
  </script>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold text-white tracking-tight font-sans">
        Buy, Borrow, Die Calculator (Australia)
      </h1>
      <p class="mt-2 text-sm text-slate-400 max-w-3xl">
        Model the Buy, Borrow, Die strategy in Australia. Compare margin loan borrowing costs vs Capital Gains Tax, check margin call risk, and see your net wealth advantage.
      </p>
    </div>

    <BuyBorrowDieCalculator defaultCurrency="AUD" />

    <!-- Explanatory Content Wrapper -->
    <div class="mt-12 space-y-8 text-slate-300">
      <!-- Introduction Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00F5D4]/10 text-[#00F5D4] text-xs font-bold uppercase tracking-wider border border-[#00F5D4]/20">
          <span>Australian Wealth Strategy</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Introduction</h2>
        <p class="text-slate-300 leading-relaxed">
          In Australia, asset-backed leverage strategies utilize margin loans or equity lines against ASX shares and managed funds to access liquidity without triggering capital gains tax (CGT). Australia's tax regime provides unique structural advantages: under Section 128-10 of the Income Tax Assessment Act 1997, death is <strong>not</strong> a CGT event, meaning capital gains tax is deferred and the asset passes to beneficiaries with the original cost basis intact. Furthermore, assets held for over 12 months qualify for a 50% CGT discount upon ultimate sale. This calculator compares Australian margin loan interest rates against discounted CGT liabilities to evaluate net wealth retention over time.
        </p>
      </section>

      <!-- Key Benefits Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7B61FF]/10 text-[#7B61FF] text-xs font-bold uppercase tracking-wider border border-[#7B61FF]/20">
          <span>Strategic Value</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Key Benefits</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Model Australian 50% CGT Discount vs. Loan Drag</strong>
              <span class="text-sm text-slate-400">Compare margin borrowing interest against CGT liabilities discounted by 50% for long-term holdings.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Understand Australian Death CGT Rollover</strong>
              <span class="text-sm text-slate-400">Evaluate how CGT deferral upon death without estate taxes impacts multi-generational wealth transfer.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Stress-Test Margin Call Buffers</strong>
              <span class="text-sm text-slate-400">Model LTV thresholds on ASX portfolio holdings to safeguard against forced broker liquidations.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Assess Income Tax Deductibility Limits</strong>
              <span class="text-sm text-slate-400">Analyze the tax impact of deductible investment borrowing versus non-deductible personal drawdowns.</span>
            </div>
          </li>
        </ul>
      </section>

      <!-- FAQ Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00F5D4]/10 text-[#00F5D4] text-xs font-bold uppercase tracking-wider border border-[#00F5D4]/20">
          <span>Common Questions</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>Is the Buy, Borrow, Die strategy legal?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              Yes, borrowing against your own assets is a standard financial practice and does not trigger a taxable event under current tax guidelines.
            </div>
          </div>

          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>Is death a Capital Gains Tax (CGT) event in Australia?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              No. Under Section 128-10 of the ITAA 1997, passing away does not trigger a CGT event. The asset transfers to your estate or beneficiary with the cost basis rolled over, deferring CGT until the beneficiary sells.
            </div>
          </div>

          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>How does the 50% CGT discount affect the borrowing comparison in Australia?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              Because Australian individuals receive a 50% CGT discount on assets held for over 12 months, the effective tax rate on liquidation is reduced by half. Your margin loan interest rate must be weighed against this reduced effective tax liability.
            </div>
          </div>
        </div>
      </section>

      <!-- Methodology Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7B61FF]/10 text-[#7B61FF] text-xs font-bold uppercase tracking-wider border border-[#7B61FF]/20">
          <span>Calculation Logic</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Methodology</h2>
        <div class="space-y-4 text-sm sm:text-base text-slate-300 leading-relaxed">
          <p>
            This calculator evaluates the net wealth outcome of liquidating Australian shareholdings versus drawing a margin loan. For share sales, the model applies the 50% CGT discount for assets held over 12 months, adding the taxable 50% net capital gain to assessable income taxed at Australian individual marginal rates (plus Medicare levy).
          </p>
          <p>
            For margin lending, the model calculates variable interest rates on drawn amounts, LTV maintenance limits, and multi-year portfolio growth. It incorporates Australia's CGT rollover rules upon death under ITAA 1997 Section 128-10, tracking tax deferral across beneficiary generations.
          </p>
          <div class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] text-xs text-slate-400 space-y-2">
            <p><strong>Official Reference:</strong> <a href="https://www.ato.gov.au/individuals-and-families/investments-and-assets/capital-gains-tax" target="_blank" rel="noopener noreferrer" class="text-[#00F5D4] hover:underline font-medium">ATO Official Capital Gains Tax Guide →</a></p>
            <p class="italic text-slate-500">Calculations are estimates, consult an Australian Registered Tax Agent or FPA-certified financial advisor before using margin lending.</p>
          
            <p class="text-xs text-slate-500 mt-3 italic">Reviewed against official ATO source documents. Last verified: [YYYY-MM-DD].</p>
          </div>
        </div>
      </section>

      <!-- Related Calculators Section -->
      <section class="space-y-4 pt-4">
        <h3 class="text-xl font-bold text-white tracking-tight">Related Calculators & Tools</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/capital-gains-tax-calculator/australia/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#00F5D4]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#00F5D4] uppercase">ATO Tax Planning</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#00F5D4] transition-colors">Australian Capital Gains Tax Calculator</h4>
            <p class="text-xs text-slate-400">Calculate ATO CGT with 50% individual discount rules.</p>
          </a>
          <a href="/tax-loss-harvesting-calculator/australia/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#7B61FF]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#7B61FF] uppercase">ATO Tax Optimization</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#7B61FF] transition-colors">Australian Tax-Loss Harvesting Calculator</h4>
            <p class="text-xs text-slate-400">Offset ASX capital gains with realized capital losses.</p>
          </a>
          <a href="/superannuation-rrsp-withdrawal-calculator/australia/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#00F5D4]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#00F5D4] uppercase">Superannuation</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#00F5D4] transition-colors">Superannuation Withdrawal Calculator</h4>
            <p class="text-xs text-slate-400">Model minimum pension drawdown percentages and tax-free limits after age 60.</p>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>
