---
/**
 * CookieConsent.astro
 * GDPR/ePrivacy-compliant cookie consent banner.
 * Stores choice in localStorage under `cookie_consent_choice`.
 * Values: 'all' | 'essential' | JSON '{"analytics":true,"advertising":false}'
 *
 * NOTE: This is the foundational consent UI only.
 * Full Google Consent Mode v2 (gtag('consent','default',...)) should be
 * implemented once AdSense is approved and ad scripts are added.
 */
---

<!-- Cookie Consent Banner -->
<div
  id="cookie-consent-banner"
  class="fixed bottom-0 inset-x-0 z-[300] hidden"
  role="dialog"
  aria-modal="false"
  aria-label="Cookie consent"
>
  <!-- Subtle backdrop gradient -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-4xl mx-auto px-4 pb-4 pt-2 sm:pb-6 sm:pt-4">
    <div class="glass-panel rounded-2xl border border-[#1E294B] shadow-2xl overflow-hidden">
      <!-- Accent bar -->
      <div class="h-0.5 w-full bg-gradient-to-r from-transparent via-[#00F5D4]/60 to-transparent"></div>

      <div class="p-5 sm:p-6">
        <!-- Main consent view -->
        <div id="consent-main">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <!-- Cookie icon + text -->
            <div class="flex items-start gap-3 flex-1 min-w-0">
              <div class="w-9 h-9 rounded-xl bg-[#00F5D4]/10 border border-[#00F5D4]/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#00F5D4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <circle cx="8" cy="9" r="1" fill="currentColor"></circle>
                  <circle cx="15" cy="8" r="1" fill="currentColor"></circle>
                  <circle cx="10" cy="14" r="1" fill="currentColor"></circle>
                  <circle cx="15" cy="13" r="1" fill="currentColor"></circle>
                </svg>
              </div>
              <div>
                <p class="text-sm text-slate-200 leading-relaxed">
                  We use cookies for analytics and to improve your experience.
                  <a href="/privacy-policy/" class="text-[#00F5D4] hover:underline font-medium">Privacy Policy</a>
                </p>
              </div>
            </div>

            <!-- Action buttons -->
            <div class="flex items-center gap-2 flex-shrink-0 w-full sm:w-auto">
              <button
                id="consent-manage-btn"
                type="button"
                class="flex-1 sm:flex-none px-4 py-2 text-xs font-semibold text-slate-300 border border-[#1E294B] rounded-lg hover:bg-slate-800 hover:text-white transition-all focus:outline-none focus:ring-2 focus:ring-[#00F5D4]/40"
              >
                Manage
              </button>
              <button
                id="consent-reject-btn"
                type="button"
                class="flex-1 sm:flex-none px-4 py-2 text-xs font-semibold text-slate-300 border border-[#1E294B] rounded-lg hover:bg-slate-800 hover:text-white transition-all focus:outline-none focus:ring-2 focus:ring-[#00F5D4]/40"
              >
                Reject Non-Essential
              </button>
              <button
                id="consent-accept-btn"
                type="button"
                class="flex-1 sm:flex-none px-4 py-2 text-xs font-bold text-[#0A0F1D] bg-[#00F5D4] rounded-lg hover:bg-[#00D4B8] transition-all focus:outline-none focus:ring-2 focus:ring-[#00F5D4]/60 shadow-lg shadow-[#00F5D4]/20"
              >
                Accept All
              </button>
            </div>
          </div>
        </div>

        <!-- Manage preferences view (hidden by default) -->
        <div id="consent-preferences" class="hidden">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-white">Cookie Preferences</h3>
              <button
                id="consent-back-btn"
                type="button"
                class="text-xs text-slate-400 hover:text-white transition-colors focus:outline-none"
              >
                ← Back
              </button>
            </div>

            <!-- Essential cookies (always on) -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-[#0A0F1D] border border-[#1E294B]">
              <div>
                <p class="text-sm font-semibold text-white">Essential</p>
                <p class="text-xs text-slate-400 mt-0.5">Required for the site to function. Cannot be disabled.</p>
              </div>
              <div class="px-3 py-1 text-3xs font-bold text-[#00F5D4] bg-[#00F5D4]/10 rounded-full border border-[#00F5D4]/20">Always On</div>
            </div>

            <!-- Analytics toggle -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-[#0A0F1D] border border-[#1E294B]">
              <div>
                <p class="text-sm font-semibold text-white">Analytics</p>
                <p class="text-xs text-slate-400 mt-0.5">Google Analytics (GA4) — helps us understand site usage.</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 ml-4">
                <input type="checkbox" id="pref-analytics" class="sr-only peer" checked>
                <div class="w-10 h-5 bg-[#1E294B] peer-focus:ring-2 peer-focus:ring-[#00F5D4]/40 rounded-full peer peer-checked:after:translate-x-5 after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-slate-400 after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[#00F5D4]/30 peer-checked:after:bg-[#00F5D4]"></div>
              </label>
            </div>

            <!-- Advertising toggle -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-[#0A0F1D] border border-[#1E294B]">
              <div>
                <p class="text-sm font-semibold text-white">Advertising</p>
                <p class="text-xs text-slate-400 mt-0.5">Personalised ad targeting via Google AdSense (not yet active).</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 ml-4">
                <input type="checkbox" id="pref-advertising" class="sr-only peer">
                <div class="w-10 h-5 bg-[#1E294B] peer-focus:ring-2 peer-focus:ring-[#00F5D4]/40 rounded-full peer peer-checked:after:translate-x-5 after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-slate-400 after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[#00F5D4]/30 peer-checked:after:bg-[#00F5D4]"></div>
              </label>
            </div>

            <!-- Save preferences button -->
            <div class="flex items-center gap-2 pt-1">
              <button
                id="consent-save-prefs-btn"
                type="button"
                class="flex-1 px-4 py-2.5 text-xs font-bold text-[#0A0F1D] bg-[#00F5D4] rounded-lg hover:bg-[#00D4B8] transition-all focus:outline-none focus:ring-2 focus:ring-[#00F5D4]/60 shadow-lg shadow-[#00F5D4]/20"
              >
                Save Preferences
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  'use strict';

  var STORAGE_KEY = 'cookie_consent_choice';

  /** Read stored consent. Returns null | 'all' | 'essential' | {analytics:bool, advertising:bool} */
  function getConsent() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      // Try JSON parse for granular choice
      try { return JSON.parse(raw); } catch(e) { return raw; }
    } catch(e) { return null; }
  }

  /** Persist consent choice */
  function setConsent(value) {
    try {
      localStorage.setItem(STORAGE_KEY, typeof value === 'string' ? value : JSON.stringify(value));
    } catch(e) {}
  }

  /** Check if analytics is consented */
  function isAnalyticsAllowed() {
    var consent = getConsent();
    if (consent === null) return false;
    if (consent === 'all') return true;
    if (consent === 'essential') return false;
    if (typeof consent === 'object' && consent.analytics === true) return true;
    return false;
  }

  /** Fire GA4 config if analytics consent was given */
  function activateGA4() {
    if (typeof window.gtag === 'function') {
      window.gtag('config', 'G-7LV68K7PQR');
    }
  }

  /** Dispatch custom event so Layout.astro script can react */
  function dispatchConsentEvent() {
    try {
      window.dispatchEvent(new CustomEvent('cookie-consent-update', { detail: getConsent() }));
    } catch(e) {}
  }

  /** Hide the banner with animation */
  function hideBanner() {
    var banner = document.getElementById('cookie-consent-banner');
    if (!banner) return;
    banner.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
    banner.style.opacity = '0';
    banner.style.transform = 'translateY(20px)';
    setTimeout(function() { banner.classList.add('hidden'); }, 300);
  }

  /** Show the banner */
  function showBanner() {
    var banner = document.getElementById('cookie-consent-banner');
    if (!banner) return;
    banner.classList.remove('hidden');
    banner.style.opacity = '0';
    banner.style.transform = 'translateY(20px)';
    // Trigger reflow
    banner.offsetHeight;
    banner.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
    banner.style.opacity = '1';
    banner.style.transform = 'translateY(0)';
  }

  // ── Initialization ──
  var consent = getConsent();

  // If consent already given, activate GA4 if allowed and don't show banner
  if (consent !== null) {
    if (isAnalyticsAllowed()) {
      activateGA4();
    }
    return; // Don't show banner
  }

  // No consent yet — show banner after a short delay for page paint
  setTimeout(showBanner, 800);

  // ── Button handlers ──
  document.addEventListener('click', function(e) {
    var target = e.target;

    // Accept All
    if (target.id === 'consent-accept-btn' || target.closest('#consent-accept-btn')) {
      setConsent('all');
      activateGA4();
      dispatchConsentEvent();
      hideBanner();
      return;
    }

    // Reject Non-Essential
    if (target.id === 'consent-reject-btn' || target.closest('#consent-reject-btn')) {
      setConsent('essential');
      dispatchConsentEvent();
      hideBanner();
      return;
    }

    // Manage Preferences — toggle view
    if (target.id === 'consent-manage-btn' || target.closest('#consent-manage-btn')) {
      var main = document.getElementById('consent-main');
      var prefs = document.getElementById('consent-preferences');
      if (main) main.classList.add('hidden');
      if (prefs) prefs.classList.remove('hidden');
      return;
    }

    // Back to main view
    if (target.id === 'consent-back-btn' || target.closest('#consent-back-btn')) {
      var main = document.getElementById('consent-main');
      var prefs = document.getElementById('consent-preferences');
      if (main) main.classList.remove('hidden');
      if (prefs) prefs.classList.add('hidden');
      return;
    }

    // Save Preferences
    if (target.id === 'consent-save-prefs-btn' || target.closest('#consent-save-prefs-btn')) {
      var analyticsChecked = document.getElementById('pref-analytics');
      var advertisingChecked = document.getElementById('pref-advertising');
      var choice = {
        analytics: analyticsChecked ? analyticsChecked.checked : false,
        advertising: advertisingChecked ? advertisingChecked.checked : false
      };
      setConsent(choice);
      if (choice.analytics) activateGA4();
      dispatchConsentEvent();
      hideBanner();
      return;
    }
  });
})();
</script>
