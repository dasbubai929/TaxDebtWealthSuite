---
import Layout from "../../layouts/Layout.astro";
import BuyBorrowDieCalculator from "../../components/BuyBorrowDieCalculator.astro";
---

<Layout
  title="Buy, Borrow, Die Calculator (United States) | TaxDebtWealthSuite"
  description="Model the Buy, Borrow, Die strategy in the US. Compare SBLOC borrowing costs vs Capital Gains Tax, check margin call risk, and see your net wealth advantage."
  ogImage="https://taxdebtwealthsuite.com/images/og-buy-borrow-die.png"
>
  <link rel="alternate" hreflang="x-default" href="https://taxdebtwealthsuite.com/buy-borrow-die-calculator/" slot="head" />
  <link rel="alternate" hreflang="en-us" href="https://taxdebtwealthsuite.com/buy-borrow-die-calculator/" slot="head" />
  <link rel="alternate" hreflang="en-gb" href="https://taxdebtwealthsuite.com/buy-borrow-die-calculator/uk/" slot="head" />
  <link rel="alternate" hreflang="en-ca" href="https://taxdebtwealthsuite.com/buy-borrow-die-calculator/canada/" slot="head" />
  <link rel="alternate" hreflang="en-au" href="https://taxdebtwealthsuite.com/buy-borrow-die-calculator/australia/" slot="head" />

  <script type="application/ld+json" is:inline slot="head">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "FinanceApplication",
        "name": "Buy, Borrow, Die Calculator (United States)",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "author": { "@id": "https://taxdebtwealthsuite.com/author/#person" },
        "provider": { "@id": "https://taxdebtwealthsuite.com/#organization" },
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "description": "Model the Buy, Borrow, Die strategy in the US. Compare SBLOC borrowing costs vs Capital Gains Tax, check margin call risk, and see your net wealth advantage."
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the Buy, Borrow, Die strategy legal?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, borrowing against your own assets is a standard financial practice and does not trigger a taxable event under current tax guidelines."
            }
          },
          {
            "@type": "Question",
            "name": "What is a Securities-Based Line of Credit (SBLOC) and how does it work?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "An SBLOC allows investors to pledge their taxable brokerage assets as collateral to secure a revolving line of credit without selling their securities. Borrowers pay variable interest on the drawn amount while keeping their underlying portfolio invested and growing."
            }
          },
          {
            "@type": "Question",
            "name": "What risks are involved with borrowing against investment portfolios?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The primary risk is a market downturn, which can trigger a margin call if the portfolio's value falls below the lender's required maintenance ratio. If uncollateralized, lenders may liquidate assets at depressed market prices, forcing capital gains realization."
            }
          }
        ]
      }
    ]
  }
  </script>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold text-white tracking-tight font-sans">
        Buy, Borrow, Die Calculator (United States)
      </h1>
      <p class="mt-2 text-sm text-slate-400 max-w-3xl">
        Model the Buy, Borrow, Die strategy in the US. Compare SBLOC borrowing costs vs Capital Gains Tax, check margin call risk, and see your net wealth advantage.
      </p>
    </div>

    <BuyBorrowDieCalculator defaultCurrency="USD" />

    <!-- Explanatory Content Wrapper -->
    <div class="mt-12 space-y-8 text-slate-300">
      <!-- Introduction Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00F5D4]/10 text-[#00F5D4] text-xs font-bold uppercase tracking-wider border border-[#00F5D4]/20">
          <span>Overview</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Introduction</h2>
        <p class="text-slate-300 leading-relaxed">
          The "Buy, Borrow, Die" strategy is a wealth preservation framework used by high-net-worth individuals to fund lifestyle expenses while avoiding premature capital gains taxation. By purchasing appreciating assets, borrowing against their value via Securities-Based Lines of Credit (SBLOC), and passing the portfolio to heirs at death, investors benefit from a step-up in tax basis. This calculator models the financial threshold where borrowing costs remain lower than liquidation taxes, helping investors quantify net wealth outcomes over multi-year horizons. Understanding this dynamic is crucial for high-net-worth wealth retention, estate planning, and tax drag mitigation.
        </p>
      </section>

      <!-- Key Benefits Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7B61FF]/10 text-[#7B61FF] text-xs font-bold uppercase tracking-wider border border-[#7B61FF]/20">
          <span>Strategic Value</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Key Benefits</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Quantify Tax Savings vs. Borrowing Costs</strong>
              <span class="text-sm text-slate-400">Compare the long-term cost of SBLOC compound interest against immediate federal and state capital gains tax liabilities.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Assess Margin Call Risk</strong>
              <span class="text-sm text-slate-400">Test portfolio market downturn scenarios to evaluate safety buffers before taking on asset-backed leverage.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Evaluate Step-Up in Basis Savings</strong>
              <span class="text-sm text-slate-400">Estimate the capital gains taxes permanently eliminated by holding assets until death under IRS Section 1014.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Optimize Liquidity Drawdowns</strong>
              <span class="text-sm text-slate-400">Model annual borrowing capacity relative to portfolio compounding growth to prevent asset depletion.</span>
            </div>
          </li>
        </ul>
      </section>

      <!-- FAQ Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00F5D4]/10 text-[#00F5D4] text-xs font-bold uppercase tracking-wider border border-[#00F5D4]/20">
          <span>Common Questions</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>Is the Buy, Borrow, Die strategy legal?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              Yes, borrowing against your own assets is a standard financial practice and does not trigger a taxable event under current tax guidelines.
            </div>
          </div>

          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>What is a Securities-Based Line of Credit (SBLOC) and how does it work?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              An SBLOC allows investors to pledge their taxable brokerage assets as collateral to secure a revolving line of credit without selling their securities. Borrowers pay variable interest on the drawn amount while keeping their underlying portfolio invested and growing.
            </div>
          </div>

          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>What risks are involved with borrowing against investment portfolios?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              The primary risk is a market downturn, which can trigger a margin call if the portfolio's value falls below the lender's required maintenance ratio. If uncollateralized, lenders may liquidate assets at depressed market prices, forcing capital gains realization.
            </div>
          </div>
        </div>
      </section>

      <!-- Methodology Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7B61FF]/10 text-[#7B61FF] text-xs font-bold uppercase tracking-wider border border-[#7B61FF]/20">
          <span>Calculation Logic</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Methodology</h2>
        <div class="space-y-4 text-sm sm:text-base text-slate-300 leading-relaxed">
          <p>
            This calculator evaluates the net wealth difference between two wealth extraction paths: selling equity holdings versus borrowing against asset equity. When liquidating assets, the tool calculates realized capital gains by subtracting your cost basis from the gross sale amount, applying your combined federal and state capital gains tax rates to calculate net cash received.
          </p>
          <p>
            For the borrowing model, the calculator simulates a Securities-Based Line of Credit (SBLOC) drawdown schedule over your selected time horizon. It factors in annual portfolio appreciation, variable borrowing rates, and cumulative interest drag, while monitoring loan-to-value (LTV) ratios against brokerage maintenance requirements.
          </p>
          <div class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] text-xs text-slate-400 space-y-2">
            <p><strong>Official Reference:</strong> <a href="https://www.irs.gov/taxtopics/tc409" target="_blank" rel="noopener noreferrer" class="text-[#00F5D4] hover:underline font-medium">IRS Topic No. 409 - Capital Gains and Losses →</a></p>
            <p class="italic text-slate-500">Calculations are estimates, consult a professional financial advisor or CPA before executing leverage strategies.</p>
          
            <p class="text-xs text-slate-500 mt-3 italic">Reviewed against official IRS source documents. Last verified: [YYYY-MM-DD].</p>
          </div>
        </div>
      </section>

      <!-- Related Calculators Section -->
      <section class="space-y-4 pt-4">
        <h3 class="text-xl font-bold text-white tracking-tight">Related Calculators & Tools</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/capital-gains-tax-calculator/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#00F5D4]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#00F5D4] uppercase">Tax Planning</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#00F5D4] transition-colors">Capital Gains Tax Calculator</h4>
            <p class="text-xs text-slate-400">Estimate short and long-term tax liabilities on investment sales across tax brackets.</p>
          </a>
          <a href="/roth-conversion-calculator/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#7B61FF]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#7B61FF] uppercase">Retirement Strategy</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#7B61FF] transition-colors">Roth Conversion Calculator</h4>
            <p class="text-xs text-slate-400">Model tax costs of converting Traditional IRAs to tax-free Roth accounts.</p>
          </a>
          <a href="/salt-cap-deduction-calculator/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#00F5D4]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#00F5D4] uppercase">Deduction Strategy</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#00F5D4] transition-colors">SALT Cap Deduction Calculator</h4>
            <p class="text-xs text-slate-400">Calculate state and local tax deduction limits and phase-down thresholds.</p>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>
