---
import Layout from '../../layouts/Layout.astro';
import TaxLossHarvestingCalculator from '../../components/TaxLossHarvestingCalculator.astro';
---

<Layout
  title="Tax Loss Harvesting Calculator (US) | Wash-Sale Rules & Offsets"
  description="Calculate your estimated tax savings from harvesting investment losses in the United States. Instantly see how capital losses offset gains and up to $3,000 of ordinary income."
  ogImage="https://taxdebtwealthsuite.com/images/og-home.png"
>
  <link rel="alternate" hreflang="x-default" href="https://taxdebtwealthsuite.com/tax-loss-harvesting-calculator/" slot="head" />
  <link rel="alternate" hreflang="en-us" href="https://taxdebtwealthsuite.com/tax-loss-harvesting-calculator/" slot="head" />
  <link rel="alternate" hreflang="en-gb" href="https://taxdebtwealthsuite.com/tax-loss-harvesting-calculator/uk/" slot="head" />
  <link rel="alternate" hreflang="en-ca" href="https://taxdebtwealthsuite.com/tax-loss-harvesting-calculator/canada/" slot="head" />
  <link rel="alternate" hreflang="en-au" href="https://taxdebtwealthsuite.com/tax-loss-harvesting-calculator/australia/" slot="head" />

  <script type="application/ld+json" is:inline slot="head">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "FinanceApplication",
        "name": "Tax Loss Harvesting Calculator (US)",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "provider": { "@id": "https://taxdebtwealthsuite.com/#organization" },
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "description": "Calculate your estimated tax savings from harvesting investment losses in the United States."
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is the IRS wash-sale rule?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The wash-sale rule prohibits you from claiming a capital loss on a security if you buy a 'substantially identical' security within 30 days before or after the sale."
            }
          },
          {
            "@type": "Question",
            "name": "How much ordinary income can I offset with capital losses?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "In the US, after your capital losses have offset your capital gains, you can use up to $3,000 of net capital loss per year to offset your ordinary income ($1,500 if married filing separately)."
            }
          },
          {
            "@type": "Question",
            "name": "What qualifies as 'substantially identical' under US wash-sale rules?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Shares of the same company or stock options on the same stock are substantially identical. However, selling an index fund from one provider (e.g. Vanguard S&P 500) and purchasing an index fund tracking a different benchmark (e.g. Schwab Total Stock Market) is generally permitted."
            }
          },
          {
            "@type": "Question",
            "name": "Does the wash-sale rule apply across IRA and taxable brokerage accounts?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Under Revenue Ruling 2008-5, if you sell stock at a loss in a taxable brokerage account and buy substantially identical stock in an IRA within 30 days, the loss is disallowed, and the disallowed loss cannot be added to the IRA's cost basis, making it permanently lost."
            }
          }
        ]
      }
    ]
  }
  </script>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold text-white tracking-tight font-sans">
        Tax Loss Harvesting Calculator
      </h1>
      <p class="mt-2 text-sm text-slate-400 max-w-3xl">
        Turn investment losses into tax savings by offsetting capital gains and up to $3,000 of ordinary income. Select your country to apply local tax code logic.
      </p>
    </div>

    <TaxLossHarvestingCalculator defaultCountry="us" />

    <!-- Explanatory Content Wrapper -->
    <div class="mt-12 space-y-8 text-slate-300">
      <!-- Introduction Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00F5D4]/10 text-[#00F5D4] text-xs font-bold uppercase tracking-wider border border-[#00F5D4]/20">
          <span>US Wash-Sale Framework</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Introduction</h2>
        <p class="text-slate-300 leading-relaxed">
          Tax-loss harvesting in the United States allows investors to sell underperforming investments at a loss to offset realized capital gains and reduce overall federal income tax liability. However, the strategy is governed by the strict <strong>IRS Wash-Sale Rule</strong> (Internal Revenue Code Section 1091), which disallows a capital loss deduction if you purchase a "substantially identical" security within 30 days before or after the sale date (a 61-day window). When a wash sale occurs, the disallowed loss is not permanently lost, but is added to the cost basis of the newly repurchased shares, deferring the tax benefit until those new shares are sold. This calculator estimates your net federal tax savings from harvesting losses while ensuring compliance with IRS offset caps.
        </p>
      </section>

      <!-- Key Benefits Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7B61FF]/10 text-[#7B61FF] text-xs font-bold uppercase tracking-wider border border-[#7B61FF]/20">
          <span>Strategic Value</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Key Benefits</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Calculate Capital Gain Offsets</strong>
              <span class="text-sm text-slate-400">Offset short-term and long-term capital gains dollar-for-dollar with harvested investment losses.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Deduct Up to $3,000 Against Ordinary Income</strong>
              <span class="text-sm text-slate-400">Apply up to $3,000 of excess net capital loss per year against ordinary income ($1,500 if married filing separately).</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Track Indefinite Loss Carryforwards</strong>
              <span class="text-sm text-slate-400">Calculate remaining net capital losses that carry forward into future tax years to offset future capital gains.</span>
            </div>
          </li>
          <li class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] flex items-start gap-3">
            <span class="text-[#00F5D4] font-bold mt-0.5">•</span>
            <div>
              <strong class="text-white block mb-1">Navigate 30-Day Wash-Sale Windows</strong>
              <span class="text-sm text-slate-400">Identify the 61-day period required to avoid disallowance when repurchasing individual stocks or index funds.</span>
            </div>
          </li>
        </ul>
      </section>

      <!-- FAQ Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00F5D4]/10 text-[#00F5D4] text-xs font-bold uppercase tracking-wider border border-[#00F5D4]/20">
          <span>Common Questions</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>What is the IRS wash-sale rule?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              The wash-sale rule prohibits you from claiming a capital loss on a security if you buy a "substantially identical" security within 30 days before or after the sale.
            </div>
          </div>

          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>How much ordinary income can I offset with capital losses?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              In the US, after your capital losses have offset your capital gains, you can use up to $3,000 of net capital loss per year to offset your ordinary income ($1,500 if married filing separately).
            </div>
          </div>

          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>What qualifies as "substantially identical" under US wash-sale rules?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              Shares of the same company or stock options on the same stock are substantially identical. However, selling an index fund from one provider (e.g. Vanguard S&P 500) and purchasing an index fund tracking a different benchmark (e.g. Schwab Total Stock Market) is generally permitted.
            </div>
          </div>

          <div class="rounded-xl bg-[#0A0F1D] border border-[#1E294B] overflow-hidden">
            <button 
              type="button"
              onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');" 
              class="w-full p-4 sm:p-5 text-left font-semibold text-white flex items-center justify-between gap-4 hover:bg-slate-900/50 transition-colors focus:outline-none"
            >
              <span>Does the wash-sale rule apply across IRA and taxable brokerage accounts?</span>
              <svg class="w-5 h-5 text-[#00F5D4] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="hidden p-4 sm:p-5 pt-0 text-sm text-slate-300 border-t border-[#1E294B]/50 leading-relaxed">
              Yes. Under Revenue Ruling 2008-5, if you sell stock at a loss in a taxable brokerage account and buy substantially identical stock in an IRA within 30 days, the loss is disallowed, and the disallowed loss cannot be added to the IRA's cost basis, making it permanently lost.
            </div>
          </div>
        </div>
      </section>

      <!-- Methodology Section -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7B61FF]/10 text-[#7B61FF] text-xs font-bold uppercase tracking-wider border border-[#7B61FF]/20">
          <span>Calculation Logic</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Methodology</h2>
        <div class="space-y-4 text-sm sm:text-base text-slate-300 leading-relaxed">
          <p>
            This calculator nets short-term losses against short-term gains and long-term losses against long-term gains before cross-netting overall net capital losses. Net realized losses offset capital gains dollar-for-dollar across all marginal tax tiers.
          </p>
          <p>
            Under Internal Revenue Code Section 1211, excess net capital losses offset up to $3,000 of ordinary income per tax year ($1,500 for married filing separately). Remaining losses carry forward indefinitely under IRC Section 1212. Cost basis adjustment logic handles wash-sale disallowances under Section 1091.
          </p>
          <div class="p-4 rounded-xl bg-[#0A0F1D] border border-[#1E294B] text-xs text-slate-400 space-y-2">
            <p><strong>Official Reference:</strong> <a href="https://www.irs.gov/publications/p550" target="_blank" rel="noopener noreferrer" class="text-[#00F5D4] hover:underline font-medium">IRS Publication 550 (Investment Income and Expenses) →</a></p>
            <p class="italic text-slate-500">Calculations are estimates, consult a CPA or licensed tax professional for tax-loss harvesting execution.</p>
          </div>
        </div>
      </section>

      <!-- Related Calculators Section -->
      <section class="space-y-4 pt-4">
        <h3 class="text-xl font-bold text-white tracking-tight">Related Calculators & Tools</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/capital-gains-tax-calculator/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#00F5D4]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#00F5D4] uppercase">Tax Planning</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#00F5D4] transition-colors">Capital Gains Tax Calculator</h4>
            <p class="text-xs text-slate-400">Estimate short and long-term capital gains tax liabilities across US income brackets.</p>
          </a>
          <a href="/buy-borrow-die-calculator/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#7B61FF]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#7B61FF] uppercase">Wealth Retention</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#7B61FF] transition-colors">Buy, Borrow, Die Calculator</h4>
            <p class="text-xs text-slate-400">Model borrowing against appreciated portfolios to avoid triggering realized capital gains taxes.</p>
          </a>
          <a href="/roth-conversion-calculator/" class="p-5 rounded-xl bg-[#0A0F1D] border border-[#1E294B] hover:border-[#00F5D4]/40 transition-all space-y-2 group">
            <span class="text-xs font-bold text-[#00F5D4] uppercase">Tax-Free Conversion</span>
            <h4 class="text-base font-bold text-white group-hover:text-[#00F5D4] transition-colors">Roth Conversion Calculator</h4>
            <p class="text-xs text-slate-400">Model pre-tax IRA conversions to build tax-free investment growth.</p>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>
